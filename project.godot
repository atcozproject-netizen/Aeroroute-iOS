; Aeroroute native 2D prototype, Godot 4.x
config_version=5

[application]
config/name="Aeroroute — Airline Empire"
run/main_scene="res://scenes/Main.tscn"
config/description="iPhone-first 2D airline network management game"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.57,0.78,0.81,1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
